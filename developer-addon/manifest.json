{
  "manifest_version": 3,
  "name": "Egodact Developer Tools",
  "version": "0.3.1",
  "description": "Developer tools for building and debugging Egodact add-ons.",
  "host_permissions": [
    "https://hoggie-homerserver.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.egodact.com/*"],
      "js": ["sdk.js", "lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
